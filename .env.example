# Retail Decision Intelligence Agent - local environment template.
# Copy to `.env.local` and fill in REAL values on the deploy host only.
#
# NEVER commit real secrets. `.env.local` is gitignored AND dockerignored, so
# it never enters a container image. Any key that has been committed, shared,
# or pasted into a review must be ROTATED (regenerated) server-side.

# --- LLM explanation + advisory layers (opt-in; both default to false) ---
# Anthropic provider (default):
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_ADVISORY_ENABLED=false
LLM_EXPLANATIONS_ENABLED=false
# Or a FREE OpenAI-compatible endpoint (Groq / Gemini / OpenRouter / Ollama ...):
# NOTE: Groq's model catalog changes; run this to see what your key can use:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
# Current free picks (verified working): qwen/qwen3.8-27b, openai/gpt-oss-120b
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_API_KEY=
# LLM_ADVISORY_ENABLED=true
# LLM_EXPLANATIONS_ENABLED=true
# Reasoning models (gpt-oss-*) spend completion tokens on hidden reasoning;
# raise the budget so the visible answer is not cut off:
# LLM_MAX_TOKENS=4000

# --- Auth for state-mutating endpoints (approve/reject, phase2 writes, runs) ---
APPROVAL_AUTH_TOKEN=

# --- External services ---
FORECAST_API_URL=https://retail-forecast-api-7sue.onrender.com/
CAMPAIGN_AUDIT_API_URL=
CAMPAIGN_AUDIT_LOG_PATH=

# --- Optional ---
# SWEEP_ENABLED=1
# SWEEP_INTERVAL_SECONDS=86400
# PENDING_APPROVAL_STATE_PATH=logs/pending_approvals.db
