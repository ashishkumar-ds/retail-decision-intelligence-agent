# Retail Decision Intelligence Agent - environment contract.
#
# This file is the authoritative list of every variable the serving code reads
# (tests/test_image_contract.py fails if a new one is added without documenting
# it here). The app is deployed as a hand-created Render service - there is no
# blueprint to inherit configuration from - so anything not set in the Render
# dashboard keeps its default below, silently. Copy to `.env.local` for local
# work, or paste the values into Dashboard -> your service -> Environment.
#
# NEVER commit real secrets. `.env.local` is gitignored AND dockerignored, so it
# never enters a container image. Any key that has been committed, shared, or
# pasted into a review must be ROTATED (regenerated) server-side.

# --- Platform-injected (do not set; Render passes it to the container) -------
# PORT                  # uvicorn binds 0.0.0.0:$PORT; defaults to 8001 locally

# --- State-mutating endpoints (approve/reject/execute/phase2 writes) ---------
# Unset -> every write path fails closed with 503 (read-only service). The
# single shared credential; simplest thing that can work on a first deploy.
APPROVAL_AUTH_TOKEN=
# Named approvers with roles, "token:user:role,..." (roles approver/viewer).
# When set it supersedes APPROVAL_AUTH_TOKEN and records decided_by.
# Optional :YYYY-MM-DD expiry per entry; expired tokens are rejected (403).
# Rotate by running old + replacement together, then deleting the old entry.
# APPROVAL_TOKENS=tok-alice:alice:approver:2027-01-01,tok-viewer:val:viewer
# Short-lived HMAC-signed tokens instead of (or alongside) the map above.
# Mint with: APPROVAL_TOKEN_SECRET=<secret> python scripts/issue_token.py alice approver
# Rotate with the old value in APPROVAL_TOKEN_SECRET_PREV during overlap.
# APPROVAL_TOKEN_SECRET=
# APPROVAL_TOKEN_SECRET_PREV=
# Set to 0 to let the service start with no credential at all (never in prod).
# APPROVAL_AUTH_TOKEN_REQUIRED=true

# --- External services this agent reads --------------------------------------
FORECAST_API_URL=https://retail-forecast-api-7sue.onrender.com/
# Project 2's audit log. Unset -> the agent falls back to the local JSONL path
# below; with neither set the sweep has no store universe and /recommendations/run
# answers 400.
CAMPAIGN_AUDIT_API_URL=
CAMPAIGN_AUDIT_LOG_PATH=
# P2 store totals for the margin proxy (tools/retail_context.py). Unset keeps
# the code default (P2 datasets/stores.csv on GitHub); the layer fails open.
# RETAIL_STORE_CONTEXT_URL=
# Store×SKU rollup for inventory-aware demand-vs-supply (tools/sku_context.py).
# Unset (default) disables the SKU layer; decisions are unchanged. Schema:
# STORE_ID,SKU,DEPARTMENT,units_56d,sales_value_56d,units_14d,on_hand
# RETAIL_SKU_ROLLUP_PATH=
# Health/confidence reliability pairing lag in days
# (/analytics/decision-quality "health_reliability" block; default 28, half a
# 56-day DiD cycle). The offline demo recordings span 21 days - set 0 there
# with the CLI --min-lag-days flag for a longer pairing view.
# RELIABILITY_MIN_LAG_DAYS=28

# --- Stakeholder board display identity (labels only, never evidence) --------
# Operator-configured campaign name shown in the board header (/board
# "campaign" object). Change per campaign; unset keeps generic copy.
# CAMPAIGN_LABEL=Campaign 18
# CAMPAIGN_TIMING_WINDOW=12 PM - 6 PM

# --- Stakeholder board display identity (labels only, never evidence) --------
# Operator-configured campaign name shown in the board header (/board
# "campaign" object). Change per campaign; unset keeps generic copy.
# CAMPAIGN_LABEL=Campaign 18
# CAMPAIGN_TIMING_WINDOW=12 PM - 6 PM

# --- Durable state (defaults under logs/, which the disk must be mounted over)
# RECOMMENDATION_LOG_PATH=logs/recommendations.jsonl
# APPROVAL_LEDGER_PATH=logs/approval_ledger.jsonl
# PENDING_APPROVAL_STATE_PATH=logs/pending_approvals.db
# EXECUTION_JOURNAL_PATH=logs/executions.jsonl
# PHASE_2_INTERVENTION_LOG_PATH=logs/phase2_interventions.jsonl
# OFFPATH_LLM_LOG_PATH=logs/offpath_llm.jsonl

# --- Storage backend for the pending-approval store --------------------------
# Unset -> embedded SQLite (inside the container: erased on restart unless the
# disk is attached). A postgres:// URL is the multi-instance answer and the only
# durable option that does not need a disk.
# Supabase (verified 2026-10-10): Dashboard -> project -> Connect -> Postgres
# -> Session pooler -> copy the string. Render is IPv4-only, so use the
# pooler (aws-0-REGION.pooler.supabase.com:5432), NOT the direct host.
# Append ?sslmode=require. Full shape:
# DATABASE_URL=postgresql://postgres.REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# NOTE: this makes pending-approvals durable, NOT the JSONL audit logs
# (see docs/DEPLOYMENT.md "Durable storage") - keep the disk for those.

# --- Cross-origin reads for an external read-only frontend --------------------
# Exact origins (comma-separated) allowed to read the public GET endpoints from
# a browser on another domain (e.g. a Vercel/v0 stakeholder board - contract:
# docs/FRONTEND_CONTRACT.md). Unset (default) = NO cross-origin access; the
# same-origin /ui is unaffected. Never "*": write paths carry Authorization.
# CORS_ALLOW_ORIGINS=https://your-board.vercel.app

# --- Execution connector (operator-selected; dry-run when unset) ------------
# dry-run journals intent and performs no external write. webhook selects the
# example real adapter (POST intent, POST cancellation); it needs the URL and
# fails closed (503) without it. Surfaced in /health.
# EXECUTION_CONNECTOR=dry-run
# EXECUTION_CONNECTOR=webhook
# EXECUTION_WEBHOOK_URL=https://pos.example/hooks/apply
# EXECUTION_WEBHOOK_TOKEN=

# --- Autonomous sweep (OFF by default; production sets both) -----------------
# The scheduler is opt-in so tests and local runs never fire live calls.
# SWEEP_ENABLED=1
# SWEEP_INTERVAL_SECONDS=86400

# --- Board self-refresh (ON by default) --------------------------------------
# On the first stale GET /board of the day the API re-evaluates its persisted
# cohort (reconstructing the campaign start from its own records when the audit
# feed is empty), so the board stamp does not freeze. Set 0 to serve the stored
# snapshot without re-evaluation.
# BOARD_SELF_REFRESH=0

# --- Capability switches (all default to enabled) ----------------------------
# RAG_ENABLED=true            # /why knowledge layer + corpus build
# PHASE2_ENABLED=true         # intervention lifecycle API
# ACTUALS_FEEDBACK_ENABLED=true  # outcome evaluation from the actuals feed

# --- LLM explanation + advisory layers (opt-in; both default to false) --------
# Anthropic provider (default):
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_ADVISORY_ENABLED=false
LLM_EXPLANATIONS_ENABLED=false
# Or a FREE OpenAI-compatible endpoint (Groq / Gemini / OpenRouter / Ollama ...):
# NOTE: Groq's model catalog changes; run this to see what your key can use:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
# Current free picks (verified working): qwen/qwen3.8-27b, openai/gpt-oss-120b
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# LLM_ADVISORY_ENABLED=true
# LLM_EXPLANATIONS_ENABLED=true
# Completion budget. Keep it near what the answer actually needs: on a free tier
# the binding limit is tokens-per-minute (Groq free = 8000), and providers count
# input + max_tokens against it - so a 4000 cap spends half the minute on one
# call and the next call 429s. A grounded rephrase measures ~1300 in / ~140 out
# here, so 1000 fits several calls a minute.
# LLM_MAX_TOKENS=1000
# LLM_ADVISORY_MAX_TOKENS=700

# Spend guard for the LLM. Both endpoints that can call the model (/why,
# /advisory) are public and unauthenticated, so the layer that costs money is
# capped twice. LLM_DAILY_CALL_BUDGET is a fact about the account: once spent,
# the endpoints serve the deterministic template instead of calling the model
# (still 200 - the demo keeps working, for free). LLM_PER_IP_HOURLY_LIMIT is a
# fact about one caller: once spent, that caller gets 429 + Retry-After while
# everyone else keeps their window. 0 = unlimited, which is what a laptop wants;
# the published demo sets both. See docs/DEPLOYMENT.md.
# LLM_PER_IP_HOURLY_LIMIT=20
# LLM_DAILY_CALL_BUDGET=250

# --- RAG retrieval pre-filter (off-path, fails open) -------------------------
# Classifier keeps/drops retrieved chunks before they reach the LLM. Disable
# with 0 to send every chunk (more context, more tokens).
# RAG_PREFILTER_ENABLED=1
# RAG_PREFILTER_TIER=fast      # fast | smart

# --- Analytics egress (opt-in; numbers are redacted either way) --------------
# Gates the BOARD root-cause section only; GET /analytics/root-causes is always
# available - an authenticated call is the explicit consent.
# ROOT_CAUSE_TAGGING_ENABLED=false
# ROOT_CAUSE_TIER=fast

